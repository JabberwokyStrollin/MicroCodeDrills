{
  "id": "SqlCodeTestMicroDrills",
  "title": "SQL Code-Test Micro Drills",
  "language": "sql",
  "sourceFile": "drill.sql",
  "blankMarker": "@@BLANK@@",
  "run": [
    "python3",
    "{packDir}/runner/run_sql.py",
    "{file}"
  ],
  "timeoutSeconds": 10,
  "passToken": "PASS",
  "count": 15,
  "topics": [
    {
      "id": "joins",
      "title": "Joins"
    },
    {
      "id": "aggregation",
      "title": "Aggregation"
    },
    {
      "id": "filtering",
      "title": "Filtering (WHERE, HAVING, IN)"
    },
    {
      "id": "sorting",
      "title": "Sorting and Limits"
    },
    {
      "id": "window",
      "title": "Window Functions"
    },
    {
      "id": "expressions",
      "title": "Expressions (COALESCE, DISTINCT, CASE)"
    }
  ]
}
